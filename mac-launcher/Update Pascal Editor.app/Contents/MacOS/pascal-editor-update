#!/bin/bash
set -euo pipefail

_LAUNCHER_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${_LAUNCHER_DIR}/../Resources/path-env.sh"

CONFIG_DIR="${HOME}/Library/Application Support/PascalEditor"
CONFIG_FILE="${CONFIG_DIR}/repo-path.txt"
LAST_LOG="${CONFIG_DIR}/update-last.log"

alert() {
  osascript -e "display alert \"$1\" message \"$2\" as informational"
}

fail_log() {
  mkdir -p "${CONFIG_DIR}"
  cp "${OUT}" "${LAST_LOG}" 2>/dev/null || true
  alert "$1" "$2 ${LAST_LOG}"
}

is_repo_root() {
  [[ -f "$1/package.json" ]] && grep -q '"name"[[:space:]]*:[[:space:]]*"editor"' "$1/package.json"
}

bundle_guess_repo() {
  local macos
  macos="$(cd "$(dirname "$0")" && pwd)"
  local candidate
  candidate="$(cd "${macos}/../../../.." && pwd)"
  if is_repo_root "${candidate}"; then
    printf '%s' "${candidate}"
    return 0
  fi
  return 1
}

prompt_repo_and_save() {
  mkdir -p "${CONFIG_DIR}"
  local chosen
  chosen="$(
    osascript <<'APPLESCRIPT'
tell application "System Events"
  activate
end tell
set p to POSIX path of (choose folder with prompt "editor のルート（package.json があるフォルダ）を選んでください")
return p
APPLESCRIPT
  )" || true
  chosen="${chosen%/}"
  if [[ -z "${chosen}" ]]; then
    exit 1
  fi
  if ! is_repo_root "${chosen}"; then
    alert "Update Pascal Editor" "選択したフォルダに editor の package.json が見つかりませんでした。"
    exit 1
  fi
  printf '%s\n' "${chosen}" >"${CONFIG_FILE}"
  printf '%s' "${chosen}"
}

ensure_repo_root() {
  mkdir -p "${CONFIG_DIR}"

  if [[ -f "${CONFIG_FILE}" ]]; then
    local saved
    saved="$(tr -d '\n' <"${CONFIG_FILE}")"
    if [[ -n "${saved}" ]] && is_repo_root "${saved}"; then
      printf '%s' "${saved}"
      return 0
    fi
  fi

  local guessed=""
  if guessed="$(bundle_guess_repo 2>/dev/null)"; then
    printf '%s\n' "${guessed}" >"${CONFIG_FILE}"
    printf '%s' "${guessed}"
    return 0
  fi

  prompt_repo_and_save
}

if ! command -v bun >/dev/null 2>&1; then
  alert "Update Pascal Editor" "Bun が見つかりません。https://bun.sh の公式手順でインストールし、~/.bun/bin に bun があることを確認してください。"
  exit 1
fi

if ! command -v git >/dev/null 2>&1; then
  alert "Update Pascal Editor" "git が見つかりません。Xcode Command Line Tools をインストールしてください。"
  exit 1
fi

REPO_ROOT="$(ensure_repo_root)"
cd "${REPO_ROOT}"

OUT="$(mktemp)"
if git pull --ff-only >>"${OUT}" 2>&1; then
  :
else
  fail_log "Update Pascal Editor" "git pull に失敗しました。詳細はログを確認してください。"
  rm -f "${OUT}"
  exit 1
fi

if bun install >>"${OUT}" 2>&1; then
  mkdir -p "${CONFIG_DIR}"
  cp "${OUT}" "${LAST_LOG}"
  rm -f "${OUT}"
  alert "Update Pascal Editor" "更新が完了しました（git pull と bun install）。詳細ログ: ${LAST_LOG}"
else
  fail_log "Update Pascal Editor" "bun install に失敗しました。詳細はログを確認してください。"
  rm -f "${OUT}"
  exit 1
fi
